# ──────────────────────────────────────────────────────────────────
#  Quant Singularity — copy this file to .env and fill in values
#  NEVER commit .env to git
# ──────────────────────────────────────────────────────────────────

# ── Mode ─────────────────────────────────────────────────────────
# Step 1: Set TESTNET=true, LIVE_MODE=false first (paper trade)
# Step 2: After 24h testnet OK → flip LIVE_MODE=true, LIVE_CONFIRM=true, TESTNET=false
QS_LIVE_MODE=false
QS_LIVE_CONFIRM=false
BINANCE_TESTNET=true

# ── Binance API ──────────────────────────────────────────────────
# Get from: https://www.binance.com/en/my/settings/api-management
# Permissions needed: Futures trading (READ + TRADE), no withdrawal
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ── Capital (USDT) ────────────────────────────────────────────────
# Must match actual Futures wallet balance
QS_TOTAL_CAPITAL=1000
QS_PASSIVE_CAPITAL=700        # long-term wealth builder
QS_ACTIVE_CAPITAL=300         # daily profit machine (~8.58 USD/day target)
QS_DUAL_MODE=true

# ── Daily target ──────────────────────────────────────────────────
# 0.0286 × 300 USDT = 8.58 USD ≈ 300 THB/day
QS_ACTIVE_DAILY_TARGET_PCT=0.0286
QS_THB_PER_USD=35.0            # update if exchange rate changes

# ── Capital allocation bounds ─────────────────────────────────────
QS_DYNAMIC_ALLOCATION=true
QS_ACTIVE_MIN_CAPITAL_FRACTION=0.20   # active never below 20% of total
QS_ACTIVE_MAX_CAPITAL_FRACTION=0.40   # active never above 40% of total
QS_ALLOCATION_REBALANCE_CYCLES=40
QS_ALLOCATION_STEP=0.05
QS_ALLOCATION_SCORE_THRESHOLD=0.01
QS_ALLOCATION_MIN_TRANSFER=5

# ── Leverage ─────────────────────────────────────────────────────
QS_PASSIVE_LEVERAGE=1          # passive: no leverage (long-term safety)
QS_ACTIVE_LEVERAGE=2           # active: 2x only

# ── Position limits ───────────────────────────────────────────────
QS_PASSIVE_MAX_POSITIONS=3
QS_ACTIVE_MAX_POSITIONS=3
QS_DUAL_ALLOW_SAME_SYMBOL_STACKING=false

# ── Passive strategy ──────────────────────────────────────────────
QS_PASSIVE_TAKE_PROFIT=0.10
QS_PASSIVE_STOP_LOSS=0.05
QS_PASSIVE_MIN_HOLD_HOURS=72
QS_PASSIVE_MAX_HOLD_HOURS=336
QS_PASSIVE_MAX_DRAWDOWN=0.10

# ── Active strategy ───────────────────────────────────────────────
QS_ACTIVE_TAKE_PROFIT=0.015
QS_ACTIVE_STOP_LOSS=0.007
QS_ACTIVE_TRADING_START=0      # 0 = trade 24h
QS_ACTIVE_TRADING_END=24
QS_ACTIVE_DAILY_LOSS_PCT=0.05  # stop active if -5% in a day

# ── Risk ─────────────────────────────────────────────────────────
QS_MAX_PORTFOLIO_DRAWDOWN=0.15  # halt everything if total portfolio drops 15%
QS_KILL_SWITCH_EQUITY=850       # hard stop if equity < 850 USDT (15% loss)

# ── System ───────────────────────────────────────────────────────
QS_LOOP_DELAY=20               # seconds between cycles (20s recommended)
QS_DASHBOARD=true
QS_DASHBOARD_PORT=8787
QS_PERSIST_PORTFOLIO=true
QS_RESET_STATS=false           # true = wipe all stats on restart (use only for fresh start)

# ── AI Brain (optional but recommended) ──────────────────────────
# Get from: https://console.anthropic.com/
# Without this, the bot works fine but skips daily Claude analysis
ANTHROPIC_API_KEY=

# ── Alerts (optional) ────────────────────────────────────────────
QS_ALERTS=false
TELEGRAM_BOT_TOKEN=            # @BotFather → create bot → get token
TELEGRAM_CHAT_ID=              # your chat ID (send /start to @userinfobot)
DISCORD_WEBHOOK_URL=
